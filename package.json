{
  "name": "energy-sentinel-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "check:api": "node scripts/check-api-contract.mjs",
    "log:new": "node scripts/new-dev-log.mjs",
    "mock:init": "msw init public --save"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fontsource/barlow": "^5.1.1",
    "@fontsource/inter": "^5.1.1",
    "@vueuse/core": "^12.5.0",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.3",
    "papaparse": "^5.4.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@iconify-json/lucide": "^1.2.20",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-icons": "^0.22.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}